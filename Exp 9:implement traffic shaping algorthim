
bucket_size = int(input("Enter bucket size: "))
output_rate = int(input("Enter output rate: "))
n = int(input("Enter number of packets: "))

bucket = 0

for i in range(n):
    packet = int(input("Enter packet size: "))

    if bucket + packet <= bucket_size:
        bucket += packet
        print("Packet accepted")
    else:
        print("Packet dropped")

    print("Current bucket size:", bucket)

    if bucket > 0:
        sent = min(bucket, output_rate)
        bucket -= sent
        print("Packets sent:", sent)

    print("Remaining bucket size:", bucket)

print("\nTraffic shaping completed")
